# Postgres connection string (Vercel Postgres / Neon, or any Postgres-compatible DB)
DATABASE_URL=postgres://user:password@localhost:5432/portfolio

# Financial Modeling Prep API key: https://financialmodelingprep.com
FMP_API_KEY=

# Fixed home currency for the whole app. See design doc — CPF tracking
# requires SGD; crypto/gold only live-price when this is USD.
HOME_CURRENCY=SGD

# bcrypt hash of the single shared login password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
#
# IMPORTANT: if you put this in a .env* file (local dev only — Vercel's
# own env var UI does NOT need this), escape every "$" as "\$". Next.js's
# env loader treats bare "$word" as variable interpolation and will
# silently corrupt the hash otherwise. Example:
#   PASSWORD_HASH=\$2b\$10\$868r/ds2c9.TJyXv.mbS5OV7Pnys/mdD8JfGo4XXCm1OaKrkcdPRi
PASSWORD_HASH=

# Random secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
